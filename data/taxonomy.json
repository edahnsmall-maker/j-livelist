{
  "_comment": "The filter vocabulary. This is the actual product opinion of j-livelist: the categories people sort themselves by, not the categories institutions describe themselves with.",
  "observanceLevels": [
    {
      "id": 1,
      "key": "secular",
      "label": "Secular / cultural",
      "blurb": "Jewish by community and culture. No religious content. Nobody will hand you a prayer book."
    },
    {
      "id": 2,
      "key": "reform",
      "label": "Reform / progressive",
      "blurb": "Egalitarian, mostly English, light ritual. Instruments and mic on Shabbat."
    },
    {
      "id": 3,
      "key": "traditional-egal",
      "label": "Conservative / traditional-egalitarian",
      "blurb": "Substantial Hebrew, traditional liturgy, men and women count equally."
    },
    {
      "id": 4,
      "key": "modern-orthodox",
      "label": "Modern Orthodox",
      "blurb": "Halachic, mechitza at davening, fully engaged with secular life and work."
    },
    {
      "id": 5,
      "key": "orthodox",
      "label": "Orthodox / Yeshivish / Chabad-style",
      "blurb": "Strictly observant. Separate seating, no phones or money on Shabbat and chag."
    }
  ],
  "_facetNote": "Observance level alone is a bad filter. It predicts vibe but not comfort. These booleans are what actually decide whether someone walks in and relaxes or walks in and freezes. They are stored independently of level, because they cross-cut it: plenty of level-2 events are strictly kosher, and plenty of level-4 events are mixed-gender socially.",
  "facets": [
    {
      "key": "kosher",
      "label": "Kosher food",
      "help": "Food served is under kosher supervision."
    },
    {
      "key": "shomerShabbat",
      "label": "Shomer Shabbat",
      "help": "Run to Shabbat observance: no phones, photos, money, or driving expected on site."
    },
    {
      "key": "mixedGender",
      "label": "Mixed seating",
      "help": "Men and women sit and participate together. False means a mechitza or separate seating."
    },
    {
      "key": "prayer",
      "label": "Includes prayer",
      "help": "There is an actual service, not just food and people."
    },
    {
      "key": "beginnerFriendly",
      "label": "Beginner friendly",
      "help": "Explains what is happening. You will not be the only one who does not know the tune."
    }
